# Frontend build configuration. Copy to .env.local for development.

# Django API base. Bookings POST to ${VITE_API_BASE_URL}/contact/ and are stored
# there; this is the system of record for leads.
VITE_API_BASE_URL=https://ithihasam.in/api

# Optional email fallback used only when the API above is unreachable, so a lead
# is never silently lost. Leave blank to disable the fallback entirely.
# Get a key at https://web3forms.com — it is public by design, but do not commit
# one: anything here ships in the JS bundle and can be used to spam your inbox.
VITE_WEB3FORMS_ACCESS_KEY=

# GA4 measurement ID (G-XXXXXXXXXX). Analytics stays completely inert — no
# script, no cookie — while this is blank.
VITE_GA_MEASUREMENT_ID=

# Build-time only: lets `npm run build` fetch blog posts so they get prerendered,
# added to sitemap-articles.xml, and included in feed.xml. If unset or
# unreachable the build still succeeds, but blog posts stay invisible to
# crawlers that do not run JavaScript.
SEO_API_BASE_URL=https://ithihasam.in/api
